# =============================================================================
# AI Portal Automation Platform — Environment Variable Reference
# INSTRUCTIONS: Copy to backend/.env and fill in real values.
# NEVER commit a .env file with real secrets.
# =============================================================================

APP_NAME="AI Portal Automation Platform"
APP_ENV=development
DEBUG=true

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-securely-generated-key

# JWT settings
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/ai_portal_dev

# Redis (future)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:5173

# Demo mode — set to true to seed demo data on startup
DEMO_MODE=true

# Screenshots directory (relative to backend/)
SCREENSHOT_DIR=screenshots

# Playwright browser — set to false for headless, true for visible (live demo)
BROWSER_HEADLESS=false
