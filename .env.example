# =============================================================================
# AI Portal Automation Platform — Environment Variable Reference
#
# INSTRUCTIONS:
#   Copy this file to .env (which is git-ignored) and fill in real values.
#   Never commit a .env file containing real secrets.
#   All secrets MUST be set via environment variables — never hard-coded.
# =============================================================================

# --- Application ---
APP_NAME="AI Portal Automation Platform"
APP_ENV=development          # development | staging | production
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-securely-generated-key

# --- Database ---
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/ai_portal_dev

# --- Redis (reserved for future background task workers) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
# Comma-separated list of allowed frontend origins
# Example: http://localhost:5173,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:5173
